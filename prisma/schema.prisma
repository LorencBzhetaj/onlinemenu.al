// Prisma schema — Platforma e Menusë Digjitale (SaaS, multi-tenant)
//
// Database: PostgreSQL (Neon). DATABASE_URL = pooled, DIRECT_URL = direct (migracionet).
// Multi-tenancy: një database e vetme, izolim me foreign key `restaurantId`.
// Çdo query nga dashboard-i filtrohet sipas restaurantId të sesionit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url: lidhja e "pooled" (runtime serverless). directUrl: lidhja direkte
  // (migracionet — PgBouncer/pooling s'e mbështet migrate deploy).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Përdoruesit dhe rolet
// ─────────────────────────────────────────────────────────────
model User {
  id            String  @id @default(cuid())
  email         String  @unique
  passwordHash  String? // null për përdoruesit që kyçen vetëm me Google OAuth
  role          String  @default("RESTAURANT_OWNER") // "SUPER_ADMIN" | "RESTAURANT_OWNER"
  emailVerified Boolean @default(false) // Google users = true; email signup verifikohet
  // Emri i restorantit i ruajtur në regjistrim; restoranti krijohet pas verifikimit.
  pendingRestaurantName String?
  // Restoranti aktiv — VETËM default navigimi; JO autoritet lejesh (shih memberships).
  activeRestaurantId String?

  restaurants  Restaurant[]
  memberships  RestaurantMembership[]
  resetTokens  PasswordResetToken[]
  verifications EmailVerification[]
  createdAt    DateTime     @default(now())
}

// Anëtarësimi i një përdoruesi në një restorant, me rol. Autoriteti i lejeve
// (Faza 1): requireRestaurantAccess rilexon këtë nga DB në çdo lexim/shkrim privat.
model RestaurantMembership {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  role         String     // "OWNER" | "MANAGER" | "STAFF"
  status       String     @default("active") // "active" | "revoked"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([userId])
}

// Verifikim email-i në regjistrim — link (token) DHE kod 6-shifror te i njëjti rekord.
// Një rekord i vetëm aktiv për user (userId unik): ridërgimi e mbishkruan (invalidon të vjetrin).
// Kredencialet ruhen VETËM si hash: tokenHash = SHA-256 (token 32-byte, entropi e lartë),
// codeHash = bcrypt (kod 6-shifror, entropi e ulët → hash i ngadaltë + kufi tentativash).
model EmailVerification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  tokenHash String   @unique // SHA-256 hex e token-it të linkut
  codeHash  String // bcrypt e kodit 6-shifror (kodi NUK është unik globalisht)
  attempts  Int      @default(0) // tentativa të gabuara kodi — lock pas MAX_CODE_ATTEMPTS
  // Versioni i kredencialit: rritet në çdo ri-dërgim (optimistic lock). Konsumimi
  // lidhet me versionin e lexuar → një ri-dërgim mes leximit dhe CAS-it e anulon atë.
  version   Int      @default(0)
  expiresAt DateTime // +1 orë
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Rate limit i qëndrueshëm në PostgreSQL (i përbashkët: regjistrim, ridërgim, verifikim).
// Një rresht për çelës (p.sh. "register:ip:1.2.3.4"); upsert atomik brenda dritares.
model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt]) // prune-i ditor filtron sipas resetAt
}

// Token për rivendosjen e password-it (Forgot/Reset Password).
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Faza 7 — Ekipi: ftesa me skadim + përdorim të vetëm
// ─────────────────────────────────────────────────────────────
// Ftesë për t'u bashkuar një restoranti me rol MANAGER/STAFF (kurrë OWNER — invarianti
// i OWNER-it ruhet; pronari kanonik krijohet vetëm në provisionim). Tokeni ruhet VETËM
// si SHA-256; pranimi është njëpërdorimësh (status → accepted) dhe skadon.
model Invitation {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  email        String // marrësi i synuar (krahasim case-insensitive në pranim)
  role         String // "MANAGER" | "STAFF"
  tokenHash    String     @unique // SHA-256 hex e token-it të ftesës (kurrë teksti i plotë)
  status       String     @default("pending") // "pending" | "accepted" | "revoked"
  expiresAt    DateTime
  invitedByUserId   String
  acceptedByUserId  String?
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Faza 7 — AuditLog: mutacionet administrative + ndryshimet kritike të roleve/abonimeve
// ─────────────────────────────────────────────────────────────
// Regjistron KUSH (aktori), ÇFARË (veprimi), KU (restoranti) dhe KUR. NUK ruan kurrë
// sekrete, token apo password. `summary` është përshkrim i shkurtër pa të dhëna të ndjeshme.
model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String? // null = sistem; pa relation (log-u mbijeton fshirjen e user-it)
  actorEmail   String? // etiketë lexueshmërie e aktorit (identitet, jo sekret)
  actorRole    String? // roli i aktorit në çastin e veprimit ("SUPER_ADMIN"|"OWNER"|...)
  restaurantId String? // tenant-i i prekur (nëse ka)
  action       String // p.sh. "subscription.update", "module.activate", "team.invite"
  targetType   String? // p.sh. "Subscription" | "Membership" | "Invitation" | "Restaurant"
  targetId     String?
  summary      String? // përshkrim i shkurtër, pa sekrete/token/PII të panevojshme
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Faza 7 — AnalyticsEvent: evente reale, tenant-scoped, PA token/email/telefon
// ─────────────────────────────────────────────────────────────
// Një rresht për event. Pa PII: vetëm tipi, restoranti, (opsionalisht) itemId dhe një
// etiketë e vogël jo-sensitive (p.sh. tipi i lidhjes). Agregimet llogariten mbi këto.
model AnalyticsEvent {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  type         String // "profile_view" | "menu_view" | "item_view" | "wolt_click" | "booking_created"
  itemId       String? // për item_view (cilat pjata klikohen më shumë)
  meta         String? // etiketë e vogël jo-sensitive (p.sh. "WOLT"); kurrë token/email/telefon
  createdAt    DateTime   @default(now())

  @@index([restaurantId, type, createdAt])
  @@index([restaurantId, itemId])
}

// ─────────────────────────────────────────────────────────────
// Restoranti (tenant)
// ─────────────────────────────────────────────────────────────
model Restaurant {
  id           String  @id @default(cuid())
  slug         String  @unique // p.sh. "gjecaj-restaurant" -> /m/gjecaj-restaurant
  name         String
  logoUrl      String?
  // Foto kopertine opsionale e profilit publik (HTTPS; ngarkohet si logoja). Pa të: brez me ngjyrë.
  coverUrl     String?
  primaryColor String? // personalizim minimal i temës
  accentColor  String?
  fontHeading  String? @default("Playfair Display")
  fontBody     String? @default("Cormorant Garamond")
  // Stili i fotos në menunë publike: "large" | "thumbnail" | "none"
  menuPhotoStyle String @default("none")
  phone        String?
  whatsapp     String?
  address      String?
  // Zbulimi/kërkimi (Faza 6): qytet + kuzhinë për filtra. Opsionale; pa vlera të sajuara.
  // Editohen te moduli Settings (UI e plotë → Faza 7); listimi i trajton null-at si "pa filtër".
  city         String?
  cuisine      String?
  // Koordinata opsionale (profil/Informacion). Lidhja e hartës ruhet si RestaurantExternalLink(MAPS).
  mapsUrl      String?
  // Koordinatat e pinit në hartën e profilit (opsionale). Pa to: vetëm adresa + lidhja e hartës.
  // Vendosen nga pronari; s'gjenerohen kurrë automatikisht (pa gjeokodim të sajuar).
  latitude     Float?
  longitude    Float?
  // Përshkrim i shkurtër i restorantit për faqen e profilit/informacionit (opsional, per-gjuhë).
  aboutAl      String?
  aboutEn      String?
  isPublished  Boolean @default(false) // owner mund ta fikë/ndezë menunë

  // Përmbajtje e Hero-s publike (opsionale; do të editohen te moduli Settings).
  estYear    Int? // p.sh. 1922 -> "EST. 1922"
  taglineAl  String? // script-line, p.sh. "Shije të Alpeve"
  taglineEn  String?
  subtitleAl String? // nëntitull uppercase, p.sh. "Kuzhinë Tradicionale · Theth"
  subtitleEn String?

  // Pezullim administrativ (Faza 1: fusha ekziston; UI e plotë → Faza 7). null = jo i pezulluar.
  suspendedAt DateTime?

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  subscription  Subscription?
  memberships   RestaurantMembership[]
  categories    Category[]
  tastingMenus  TastingMenu[]
  analytics     MenuView[]
  analyticsEvents AnalyticsEvent[]
  invitations   Invitation[]
  externalLinks RestaurantExternalLink[]
  allergens     Allergen[]
  menuSchedules MenuSchedule[]
  qrCode        QrCode?

  // Booking (Faza 4) — gjithçka e izoluar me restaurantId.
  bookingSettings BookingSettings?
  areas           Area[]
  tables          RestaurantTable[]
  combinations    TableCombination[]
  reservations    Reservation[]
  customers       Customer[]
  openingHours    OpeningHour[]
  closures        Closure[]
  areaClosures    AreaClosure[]
  slotLimits      SlotLimit[]
  notificationJobs NotificationJob[]
  dailyReports    DailyReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  // Listimi publik filtron shpesh mbi publikim + qytet/kuzhinë (Faza 6).
  @@index([isPublished, city])
  @@index([isPublished, cuisine])
}

// ─────────────────────────────────────────────────────────────
// Lidhje të jashtme opsionale (Wolt, Maps, Instagram, Website)
// Hapen nga shfletuesi; serveri s'merr menu/porosi prej tyre. Validim URL në service
// (HTTPS + host allowlist për Wolt/Instagram). Telefoni ruhet te Restaurant.phone (tel:).
// ─────────────────────────────────────────────────────────────
model RestaurantExternalLink {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  type         String // "WOLT" | "MAPS" | "INSTAGRAM" | "WEBSITE"
  url          String
  enabled      Boolean    @default(true)
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, type])
  @@index([restaurantId])
}

// Kod QR opak dhe i pandryshueshëm → resolver `/q/[code]` çon te profili i restorantit.
// Një rekord për restorant. `/m/[slug]` ruhet si alias historik (redirect te profili).
model QrCode {
  code         String     @id // kod opak (nuk kodon datë/tavolinë/rezervim)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String     @unique
  createdAt    DateTime   @default(now())
}

// Alergjenë të përcaktuar nga restoranti (tenant-scoped); lidhen me artikuj (M:N).
model Allergen {
  id           String             @id @default(cuid())
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  nameAl       String
  nameEn       String
  icon         String?
  sortOrder    Int                @default(0)
  items        MenuItemAllergen[]

  @@index([restaurantId])
}

model MenuItemAllergen {
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  allergenId String

  @@id([menuItemId, allergenId])
  @@index([allergenId])
}

// Orari i menusë: dritare kohore javore. Kategoritë mund të lidhen me një orar —
// shfaqen në menunë publike vetëm kur ora aktuale (Europe/Tirane) bie brenda dritares.
// Kategoritë pa orar shfaqen gjithmonë. days: 0=E Diel … 6=E Shtunë; minuta nga mesnata.
model MenuSchedule {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  label        String
  days         Int[]
  startMinutes Int // 0..1439
  endMinutes   Int // 0..1440; nëse < startMinutes → dritare që kalon mesnatën
  categories   Category[]

  @@index([restaurantId])
}

// ─────────────────────────────────────────────────────────────
// Abonimi (menaxhim gjysmë-manual, pa Stripe në fillim)
// ─────────────────────────────────────────────────────────────
model Subscription {
  id              String     @id @default(cuid())
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId    String     @unique
  plan            String // "monthly" | "quarterly" | "yearly"
  status          String     @default("trial") // "trial" | "active" | "expired" | "cancelled"
  startedAt       DateTime   @default(now())
  expiresAt       DateTime
  lastPaymentNote String? // shënim manual (p.sh. "Paguar via WhatsApp 10/08")

  entitlements    ModuleEntitlement[]
}

// Të drejta per-modul (MENU/BOOKING) të ndara mbi abonimin. hasEntitlement vlerëson
// me allowlist (shih docs/architecture/phase-1-spec-and-plan.md §5).
model ModuleEntitlement {
  id             String       @id @default(cuid())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  module         String       // "MENU" | "BOOKING"
  status         String       @default("active") // "active" | "expired" | "disabled"
  expiresAt      DateTime?    // null = pa skadim në nivel moduli (qeveris subscription-i)

  @@unique([subscriptionId, module])
}

// ─────────────────────────────────────────────────────────────
// Struktura e menusë: Category -> Subcategory? -> MenuItem
// ─────────────────────────────────────────────────────────────
model Category {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  nameAl       String
  nameEn       String
  icon         String?
  sortOrder    Int        @default(0)
  // Orar opsional i menusë: kategoria shfaqet publikisht vetëm brenda dritares së orarit.
  schedule     MenuSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId   String?

  subcategories Subcategory[]
  items         MenuItem[] // përdoret nëse s'ka subcategories

  @@index([restaurantId])
  @@index([scheduleId])
}

model Subcategory {
  id         String   @id @default(cuid())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  nameAl     String
  nameEn     String
  sortOrder  Int      @default(0)

  items MenuItem[]

  @@index([categoryId])
}

model MenuItem {
  id            String       @id @default(cuid())
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  subcategoryId String?

  nameAl String
  nameEn String
  descAl String?
  descEn String?
  price  Int // në lek/cent (Int, jo decimal — shmang gabime rrumbullakimi)

  imageUrl    String?
  isChefPick  Boolean @default(false) // "Rekomandimet e Shefit"
  isDailyMenu Boolean @default(false) // "Menu Ditore"
  isVisible   Boolean @default(true) // false = fshehur plotësisht nga menuja publike
  // false = shfaqet por i shënuar "përkohësisht i padisponueshëm" (ndryshe nga fshehja).
  isAvailable Boolean @default(true)
  avgRating   Float?  @default(0) // vlerësim me yje
  ratingCount Int     @default(0)
  sortOrder   Int     @default(0)

  allergens MenuItemAllergen[]

  @@index([categoryId])
  @@index([subcategoryId])
}

// ─────────────────────────────────────────────────────────────
// Menu degustuese
// ─────────────────────────────────────────────────────────────
model TastingMenu {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  price        Int
  guestCount   Int        @default(2)
  // JSON: [{titleAl, titleEn, descAl, descEn}] — tip Json nativ në PostgreSQL.
  courses      Json

  @@index([restaurantId])
}

// ─────────────────────────────────────────────────────────────
// Analitika (tracking shikimesh/klikimesh)
// ─────────────────────────────────────────────────────────────
model MenuView {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  itemId       String? // për "cilat pjata klikohen më shumë"
  viewedAt     DateTime   @default(now())

  @@index([restaurantId])
  @@index([itemId])
}

// ─────────────────────────────────────────────────────────────
// BOOKING (Faza 4) — motori i rezervimeve, i përshtatur nga repo `restorant`
// (single-tenant) në multi-tenant: restaurantId në çdo entitet dhe operacion.
// Politikat e booking-ut rrinë te BookingSettings; brandi/kontaktet te Restaurant.
// ─────────────────────────────────────────────────────────────

// Politikat e rezervimit për një restorant (një rresht për restorant).
model BookingSettings {
  id                     String     @id @default(cuid())
  restaurant             Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId           String     @unique
  turnDurationMinutes    Int        @default(120) // sa mbahet një tavolinë për rezervim
  bookingInterval        Int        @default(30) // granulariteti i slot-eve, minuta
  seatingBuffer          Int        @default(15) // minuta mes rezervimeve në të njëjtën tavolinë
  maxPartySize           Int        @default(12)
  maxReservationsPerSlot Int        @default(0) // 0 = pa kufi (kufizon vetëm numri i tavolinave)
  maxCoversPerSlot       Int        @default(0) // 0 = pa kufi
  timezone               String     @default("Europe/Tirane")
  updatedAt              DateTime   @updatedAt
}

// Zonë e restorantit (Brenda / Jashtë / Terrasë…). isOpen = status i përhershëm.
model Area {
  id               String     @id @default(cuid())
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId     String
  name             String
  kind             String     @default("indoor") // indoor | outdoor
  isOpen           Boolean    @default(true)
  weatherDependent Boolean    @default(false)
  priority         Int        @default(0) // më i ulët = i preferuar për "pa preferencë"
  sortOrder        Int        @default(0)

  tables       RestaurantTable[]
  closures     AreaClosure[]
  combinations TableCombination[]

  @@index([restaurantId])
  @@index([kind])
}

// Mbyllje e përkohshme e një zone për një dritare datë/orë (mot, event privat…).
model AreaClosure {
  id            String     @id @default(cuid())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId  String
  area          Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  areaId        String
  startDateTime DateTime
  endDateTime   DateTime
  reason        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([restaurantId])
  @@index([areaId])
  @@index([startDateTime])
  @@index([endDateTime])
}

model RestaurantTable {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  seats        Int
  section      String     @default("")
  area         Area?      @relation(fields: [areaId], references: [id])
  areaId       String?
  shape        String     @default("square") // square | round | rect
  x            Int        @default(0)
  y            Int        @default(0)
  w            Int        @default(2)
  h            Int        @default(2)
  rotation     Int        @default(0)
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  reservations       Reservation[]
  reservationTables  ReservationTable[]
  combinationMembers TableCombinationMember[]

  @@index([restaurantId])
  @@index([areaId])
}

// Grupim i para-përcaktuar i dy+ tavolinave reale për një grup të madh. I kuruar
// nga stafi — motori s'shpik kombinime. Të gjithë anëtarët në të njëjtën zonë.
model TableCombination {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  area         Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  areaId       String
  minSeats     Int?
  maxSeats     Int
  priority     Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  members TableCombinationMember[]

  @@index([restaurantId])
  @@index([areaId])
  @@index([isActive])
}

model TableCombinationMember {
  id            String @id @default(cuid())
  combinationId String
  tableId       String

  combination TableCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  table       RestaurantTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([combinationId, tableId])
  @@index([tableId])
}

// Lidhja rezervim ↔ tavolina (burimi autoritativ multi-tavolinë).
model ReservationTable {
  id            String @id @default(cuid())
  reservationId String
  tableId       String

  // reservation→Cascade: fshirja e një rezervimi heq rreshtat e tij join.
  // table→Restrict: një tavolinë me histori rezervimesh NUK fshihet (çaktivizohet).
  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@unique([reservationId, tableId])
  @@index([tableId])
  @@index([reservationId])
}

// Klient i ndarë sipas restorantit (nuk bashkohet globalisht nga telefoni).
model Customer {
  id             String     @id @default(cuid())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  firstName      String
  lastName       String     @default("")
  phone          String
  whatsappNumber String?
  email          String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  reservations Reservation[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
}

model Reservation {
  id             String     @id @default(cuid())
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  cancelToken    String     @unique @default(cuid())
  // Idempotency unik PER TENANT: një ritentativë me të njëjtin çelës kthen të njëjtin rezervim.
  idempotencyKey String?
  tableId        String
  customerId     String
  startDateTime  DateTime
  endDateTime    DateTime
  partySize      Int
  status         String     @default("Confirmed") // Confirmed | Seated | Completed | Cancelled | NoShow
  notes          String?
  source         String     @default("Online") // Online | Walk-in | Phone
  requestedArea  String     @default("no_preference") // indoor | outdoor | no_preference
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Restrict: ruajtja e historikut — një tavolinë/klient me rezervime NUK fshihet
  // aksidentalisht. Fshirja e tenant-it bëhet rrjedhë e posaçme (fshin rezervimet
  // e para, në rend), jo me cascade nga tavolina/klienti.
  table            RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tables           ReservationTable[]
  notificationJobs NotificationJob[]

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId])
  @@index([tableId, startDateTime])
  @@index([startDateTime])
  @@index([customerId])
  @@index([status])
}

// Orari i hapjes (mund të ketë disa periudha për ditë: drekë/darkë).
model OpeningHour {
  id              String     @id @default(cuid())
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId    String
  dayOfWeek       Int // 0 = E Diel … 6 = E Shtunë
  startTime       String // "HH:mm"
  endTime         String // "HH:mm" (rezervimi mund të vazhdojë PAS kësaj)
  lastBookingTime String? // ora e fundit e lejuar e fillimit (inclusive), opsionale
  isActive        Boolean    @default(true)

  @@index([restaurantId])
  @@index([dayOfWeek])
}

// Mbyllje e të gjithë restorantit (një ditë ose interval).
model Closure {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  startDate    DateTime
  endDate      DateTime
  reason       String?

  @@index([restaurantId])
}

// Mbivendosje për kufijtë e slot-eve, p.sh. "max 4 rezervime në 18:00".
model SlotLimit {
  id              String     @id @default(cuid())
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId    String
  dayOfWeek       Int? // null = çdo ditë
  time            String // "HH:mm"
  areaKind        String? // null = i gjithë restoranti; "indoor" | "outdoor"
  maxReservations Int
  maxCovers       Int?

  @@index([restaurantId])
  @@index([time])
}

// ─────────────────────────────────────────────────────────────
// NJOFTIME (Faza 5) — job-i krijohet NË TË NJËJTIN transaksion me rezervimin;
// worker-i i dërgon PAS commit-it. Retry/lease/dedupe; dështimi i email-it NUK
// anulon një rezervim të kryer. Në test: email sink, pa dërgime reale.
// ─────────────────────────────────────────────────────────────
model NotificationJob {
  id            String       @id @default(cuid())
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId  String
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId String?
  type          String // BookingConfirmation | Cancellation | Reschedule | Reminder24h | Reminder2h | Completed | NoShow | DailyDigest
  channel       String       @default("Email")
  recipient     String
  payload       Json
  // Dedupe: një job për (rezervim, event, version). Ri-krijimi i të njëjtit event
  // s'dyfishon dërgimin. Për digest: çelës sipas tenant+datë.
  dedupeKey     String       @unique
  status        String       @default("Pending") // Pending | Sending | Sent | Simulated | Failed | Dead
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5)
  scheduledAt   DateTime     @default(now()) // kur bëhet i gatshëm për dërgim (kujtesat në të ardhmen)
  leaseUntil    DateTime? // lease: një worker e merr deri në këtë kohë (shmang dërgim i dyfishtë)
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  deliveries NotificationDelivery[]

  @@index([restaurantId])
  @@index([status, scheduledAt])
  @@index([reservationId])
}

// Log per-tentativë i dërgimit (audit i vogël; pa exactly-once për SMTP).
model NotificationDelivery {
  id        String          @id @default(cuid())
  job       NotificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  attempt   Int
  outcome   String // sent | simulated | failed
  detail    String?
  createdAt DateTime        @default(now())

  @@index([jobId])
}

// Një rresht për datë-lokale + tip raporti → raporti ditor idempotent (një email/datë).
model DailyReport {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  reportDate   String // datë kalendarike lokale "YYYY-MM-DD" (zona e restorantit)
  type         String     @default("DailyDigest")
  status       String     @default("Pending") // Pending | Sent | Failed
  reservations Int        @default(0)
  guests       Int        @default(0)
  startedAt    DateTime   @default(now())
  sentAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, reportDate, type])
  @@index([restaurantId])
}
