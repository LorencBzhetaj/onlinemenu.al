// Prisma schema — Platforma e Menusë Digjitale (SaaS, multi-tenant)
//
// Database: PostgreSQL (Neon). DATABASE_URL = pooled, DIRECT_URL = direct (migracionet).
// Multi-tenancy: një database e vetme, izolim me foreign key `restaurantId`.
// Çdo query nga dashboard-i filtrohet sipas restaurantId të sesionit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url: lidhja e "pooled" (runtime serverless). directUrl: lidhja direkte
  // (migracionet — PgBouncer/pooling s'e mbështet migrate deploy).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Përdoruesit dhe rolet
// ─────────────────────────────────────────────────────────────
model User {
  id            String  @id @default(cuid())
  email         String  @unique
  passwordHash  String? // null për përdoruesit që kyçen vetëm me Google OAuth
  role          String  @default("RESTAURANT_OWNER") // "SUPER_ADMIN" | "RESTAURANT_OWNER"
  emailVerified Boolean @default(false) // Google users = true; email signup verifikohet
  // Emri i restorantit i ruajtur në regjistrim; restoranti krijohet pas verifikimit.
  pendingRestaurantName String?
  // Restoranti aktiv — VETËM default navigimi; JO autoritet lejesh (shih memberships).
  activeRestaurantId String?

  restaurants  Restaurant[]
  memberships  RestaurantMembership[]
  resetTokens  PasswordResetToken[]
  verifications EmailVerification[]
  createdAt    DateTime     @default(now())
}

// Anëtarësimi i një përdoruesi në një restorant, me rol. Autoriteti i lejeve
// (Faza 1): requireRestaurantAccess rilexon këtë nga DB në çdo lexim/shkrim privat.
model RestaurantMembership {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  role         String     // "OWNER" | "MANAGER" | "STAFF"
  status       String     @default("active") // "active" | "revoked"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@index([userId])
}

// Verifikim email-i në regjistrim — link (token) DHE kod 6-shifror te i njëjti rekord.
// Një rekord i vetëm aktiv për user (userId unik): ridërgimi e mbishkruan (invalidon të vjetrin).
// Kredencialet ruhen VETËM si hash: tokenHash = SHA-256 (token 32-byte, entropi e lartë),
// codeHash = bcrypt (kod 6-shifror, entropi e ulët → hash i ngadaltë + kufi tentativash).
model EmailVerification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  tokenHash String   @unique // SHA-256 hex e token-it të linkut
  codeHash  String // bcrypt e kodit 6-shifror (kodi NUK është unik globalisht)
  attempts  Int      @default(0) // tentativa të gabuara kodi — lock pas MAX_CODE_ATTEMPTS
  // Versioni i kredencialit: rritet në çdo ri-dërgim (optimistic lock). Konsumimi
  // lidhet me versionin e lexuar → një ri-dërgim mes leximit dhe CAS-it e anulon atë.
  version   Int      @default(0)
  expiresAt DateTime // +1 orë
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Rate limit i qëndrueshëm në PostgreSQL (i përbashkët: regjistrim, ridërgim, verifikim).
// Një rresht për çelës (p.sh. "register:ip:1.2.3.4"); upsert atomik brenda dritares.
model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

// Token për rivendosjen e password-it (Forgot/Reset Password).
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Restoranti (tenant)
// ─────────────────────────────────────────────────────────────
model Restaurant {
  id           String  @id @default(cuid())
  slug         String  @unique // p.sh. "gjecaj-restaurant" -> /m/gjecaj-restaurant
  name         String
  logoUrl      String?
  primaryColor String? // personalizim minimal i temës
  accentColor  String?
  fontHeading  String? @default("Playfair Display")
  fontBody     String? @default("Cormorant Garamond")
  // Stili i fotos në menunë publike: "large" | "thumbnail" | "none"
  menuPhotoStyle String @default("none")
  phone        String?
  whatsapp     String?
  address      String?
  // Koordinata opsionale (profil/Informacion). Lidhja e hartës ruhet si RestaurantExternalLink(MAPS).
  mapsUrl      String?
  // Përshkrim i shkurtër i restorantit për faqen e profilit/informacionit (opsional, per-gjuhë).
  aboutAl      String?
  aboutEn      String?
  isPublished  Boolean @default(false) // owner mund ta fikë/ndezë menunë

  // Përmbajtje e Hero-s publike (opsionale; do të editohen te moduli Settings).
  estYear    Int? // p.sh. 1922 -> "EST. 1922"
  taglineAl  String? // script-line, p.sh. "Shije të Alpeve"
  taglineEn  String?
  subtitleAl String? // nëntitull uppercase, p.sh. "Kuzhinë Tradicionale · Theth"
  subtitleEn String?

  // Pezullim administrativ (Faza 1: fusha ekziston; UI e plotë → Faza 7). null = jo i pezulluar.
  suspendedAt DateTime?

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  subscription  Subscription?
  memberships   RestaurantMembership[]
  categories    Category[]
  tastingMenus  TastingMenu[]
  analytics     MenuView[]
  externalLinks RestaurantExternalLink[]
  allergens     Allergen[]
  menuSchedules MenuSchedule[]
  qrCode        QrCode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// ─────────────────────────────────────────────────────────────
// Lidhje të jashtme opsionale (Wolt, Maps, Instagram, Website)
// Hapen nga shfletuesi; serveri s'merr menu/porosi prej tyre. Validim URL në service
// (HTTPS + host allowlist për Wolt/Instagram). Telefoni ruhet te Restaurant.phone (tel:).
// ─────────────────────────────────────────────────────────────
model RestaurantExternalLink {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  type         String // "WOLT" | "MAPS" | "INSTAGRAM" | "WEBSITE"
  url          String
  enabled      Boolean    @default(true)
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, type])
  @@index([restaurantId])
}

// Kod QR opak dhe i pandryshueshëm → resolver `/q/[code]` çon te profili i restorantit.
// Një rekord për restorant. `/m/[slug]` ruhet si alias historik (redirect te profili).
model QrCode {
  code         String     @id // kod opak (nuk kodon datë/tavolinë/rezervim)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String     @unique
  createdAt    DateTime   @default(now())
}

// Alergjenë të përcaktuar nga restoranti (tenant-scoped); lidhen me artikuj (M:N).
model Allergen {
  id           String             @id @default(cuid())
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  nameAl       String
  nameEn       String
  icon         String?
  sortOrder    Int                @default(0)
  items        MenuItemAllergen[]

  @@index([restaurantId])
}

model MenuItemAllergen {
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  allergenId String

  @@id([menuItemId, allergenId])
  @@index([allergenId])
}

// Orari i menusë: dritare kohore javore. Kategoritë mund të lidhen me një orar —
// shfaqen në menunë publike vetëm kur ora aktuale (Europe/Tirane) bie brenda dritares.
// Kategoritë pa orar shfaqen gjithmonë. days: 0=E Diel … 6=E Shtunë; minuta nga mesnata.
model MenuSchedule {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  label        String
  days         Int[]
  startMinutes Int // 0..1439
  endMinutes   Int // 0..1440; nëse < startMinutes → dritare që kalon mesnatën
  categories   Category[]

  @@index([restaurantId])
}

// ─────────────────────────────────────────────────────────────
// Abonimi (menaxhim gjysmë-manual, pa Stripe në fillim)
// ─────────────────────────────────────────────────────────────
model Subscription {
  id              String     @id @default(cuid())
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId    String     @unique
  plan            String // "monthly" | "quarterly" | "yearly"
  status          String     @default("trial") // "trial" | "active" | "expired" | "cancelled"
  startedAt       DateTime   @default(now())
  expiresAt       DateTime
  lastPaymentNote String? // shënim manual (p.sh. "Paguar via WhatsApp 10/08")

  entitlements    ModuleEntitlement[]
}

// Të drejta per-modul (MENU/BOOKING) të ndara mbi abonimin. hasEntitlement vlerëson
// me allowlist (shih docs/architecture/phase-1-spec-and-plan.md §5).
model ModuleEntitlement {
  id             String       @id @default(cuid())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  module         String       // "MENU" | "BOOKING"
  status         String       @default("active") // "active" | "expired" | "disabled"
  expiresAt      DateTime?    // null = pa skadim në nivel moduli (qeveris subscription-i)

  @@unique([subscriptionId, module])
}

// ─────────────────────────────────────────────────────────────
// Struktura e menusë: Category -> Subcategory? -> MenuItem
// ─────────────────────────────────────────────────────────────
model Category {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  nameAl       String
  nameEn       String
  icon         String?
  sortOrder    Int        @default(0)
  // Orar opsional i menusë: kategoria shfaqet publikisht vetëm brenda dritares së orarit.
  schedule     MenuSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId   String?

  subcategories Subcategory[]
  items         MenuItem[] // përdoret nëse s'ka subcategories

  @@index([restaurantId])
  @@index([scheduleId])
}

model Subcategory {
  id         String   @id @default(cuid())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  nameAl     String
  nameEn     String
  sortOrder  Int      @default(0)

  items MenuItem[]

  @@index([categoryId])
}

model MenuItem {
  id            String       @id @default(cuid())
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId    String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  subcategoryId String?

  nameAl String
  nameEn String
  descAl String?
  descEn String?
  price  Int // në lek/cent (Int, jo decimal — shmang gabime rrumbullakimi)

  imageUrl    String?
  isChefPick  Boolean @default(false) // "Rekomandimet e Shefit"
  isDailyMenu Boolean @default(false) // "Menu Ditore"
  isVisible   Boolean @default(true) // false = fshehur plotësisht nga menuja publike
  // false = shfaqet por i shënuar "përkohësisht i padisponueshëm" (ndryshe nga fshehja).
  isAvailable Boolean @default(true)
  avgRating   Float?  @default(0) // vlerësim me yje
  ratingCount Int     @default(0)
  sortOrder   Int     @default(0)

  allergens MenuItemAllergen[]

  @@index([categoryId])
  @@index([subcategoryId])
}

// ─────────────────────────────────────────────────────────────
// Menu degustuese
// ─────────────────────────────────────────────────────────────
model TastingMenu {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  price        Int
  guestCount   Int        @default(2)
  // JSON: [{titleAl, titleEn, descAl, descEn}] — tip Json nativ në PostgreSQL.
  courses      Json

  @@index([restaurantId])
}

// ─────────────────────────────────────────────────────────────
// Analitika (tracking shikimesh/klikimesh)
// ─────────────────────────────────────────────────────────────
model MenuView {
  id           String     @id @default(cuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  itemId       String? // për "cilat pjata klikohen më shumë"
  viewedAt     DateTime   @default(now())

  @@index([restaurantId])
  @@index([itemId])
}
