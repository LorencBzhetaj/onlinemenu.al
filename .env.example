# ─────────────────────────────────────────────────────────────
# MenuDigjitale — variablat e mjedisit (kopjoje si .env dhe plotëso)
# Në prodhim: vendosi te Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ──
# DATABASE_URL = lidhja "Pooled" (runtime serverless) — host me "-pooler"
# DIRECT_URL   = lidhja "Direct" (migracionet) — host pa "-pooler"
# Të dyja gjenden te Neon → Dashboard → Connection Details. Përfshi ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── NextAuth ──
# Gjenero: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Në prodhim = URL-ja e plotë e faqes, p.sh. https://menudigjitale.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── URL bazë publike (përdoret për gjenerim QR: [BASE]/m/[slug]) ──
# KRITIKE në prodhim: domain-i real, JO localhost — përndryshe QR-t dalin gabim.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Cloudinary (upload imazhesh) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ── Google OAuth (Sign-In alternativ) ──
# Nga Google Cloud Console → Credentials → OAuth Client (Web).
# Authorized redirect URI: https://DOMAINI/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cron (skadime automatike) ──
# Sekret që mbron /api/cron/check-subscriptions. Gjenero: openssl rand -hex 32
CRON_SECRET=""

# ── Super Admin fillestar (përdoret nga prisma/seed.ts) ──
SEED_ADMIN_EMAIL="admin@platforma.al"
SEED_ADMIN_PASSWORD=""
