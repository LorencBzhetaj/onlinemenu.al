# ─────────────────────────────────────────────────────────────
# MenuDigjitale — variablat e mjedisit (kopjoje si .env dhe plotëso)
# Në prodhim: vendosi te Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ──
# DATABASE_URL = lidhja "Pooled" (runtime serverless) — host me "-pooler"
# DIRECT_URL   = lidhja "Direct" (migracionet) — host pa "-pooler"
# Të dyja gjenden te Neon → Dashboard → Connection Details. Përfshi ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ── NextAuth ──
# Gjenero: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Në prodhim = URL-ja e plotë e faqes, p.sh. https://menudigjitale.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── URL bazë publike (përdoret për gjenerim QR: [BASE]/m/[slug]) ──
# KRITIKE në prodhim: domain-i real, JO localhost — përndryshe QR-t dalin gabim.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Cloudinary (upload imazhesh) ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ── Google OAuth (Sign-In alternativ) ──
# Nga Google Cloud Console → Credentials → OAuth Client (Web).
# Authorized redirect URI: https://DOMAINI/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Cron (skadime automatike + njoftime) ──
# Sekret që mbron /api/cron/check-subscriptions DHE /api/cron/notifications.
# Gjenero: openssl rand -hex 32. Vercel Cron dërgon "Authorization: Bearer <CRON_SECRET>".
# Orari te vercel.json (HOBBY): vetëm check-subscriptions çdo ditë 03:00 (Hobby lejon vetëm
# cron ditor). Njoftimet e booking-ut (konfirmim/anulim) përpunohen INLINE pas commit-it te
# rrugët e rezervimit, pa cron. Kujtesat 24h + retry-të kërkojnë një thirrje të planifikuar:
# në PRO shto cron-in /api/cron/notifications (p.sh. */5), ose në Hobby një scheduler i jashtëm
# që godet /api/cron/notifications me "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# ── Email (Resend) ──
RESEND_API_KEY=""
# PËR TANI: onboarding@resend.dev. Pas verifikimit të DNS-së:
#   EMAIL_FROM="MenuDigjitale <noreply@onlinemenu.al>"
EMAIL_FROM="MenuDigjitale <onboarding@resend.dev>"
# DËRGIM REAL i njoftimeve të booking-ut është OPT-IN: vetëm PROD vendos EMAIL_SEND_LIVE=1
# (me një RESEND_API_KEY real). Pa këtë flag → njoftimet SIMULOHEN (email sink) në
# staging/Preview/CI/lokal, pa dërguar email mysafirëve realë.
EMAIL_SEND_LIVE=""

# ── Indeksimi (staging/Preview) ──
# Vendos NOINDEX=1 në staging/Preview që robots.txt të bëjë disallow të plotë dhe faqet
# të marrin meta noindex. Në prod lëre bosh. (Mjediset Vercel jo-"production" de-indeksohen
# automatikisht edhe pa këtë flag, përmes VERCEL_ENV.)
NOINDEX=""

# ─────────────────────────────────────────────────────────────
# STAGING/PREVIEW — izolim nga prodhimi (Faza 8):
#  • DATABASE_URL/DIRECT_URL = një projekt/branch Neon I NDARË nga prod (asnjë rresht i
#    përbashkët; migrimet aplikohen vetëm këtu, kurrë mbi prod).
#  • NEXTAUTH_SECRET, CRON_SECRET = sekrete TË NDARA nga prod.
#  • NEXT_PUBLIC_BASE_URL / NEXTAUTH_URL = domain-i i staging-ut.
#  • EMAIL_SEND_LIVE bosh (sink) + NOINDEX=1.
# ─────────────────────────────────────────────────────────────

# ── Super Admin fillestar (përdoret nga prisma/seed.ts) ──
SEED_ADMIN_EMAIL="admin@platforma.al"
SEED_ADMIN_PASSWORD=""
